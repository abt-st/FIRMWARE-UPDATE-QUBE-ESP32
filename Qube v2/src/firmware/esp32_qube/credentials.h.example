// credentials.h.example — plantilla de credenciales WiFi STA
//
// USO: copiar este archivo a `credentials.h` (mismo directorio) y reemplazar los
// valores. `credentials.h` está en .gitignore y NO debe commitearse.
//
//   cp credentials.h.example credentials.h
//
// Estos valores son sólo el FALLBACK: se usan cuando NVS está vacío. Una vez
// configurado el SSID por serial (`wifi_ssid<red>` / `wifi_pass<clave>`) o por
// HTTP (`/cmd?wifi_ssid=...`), las credenciales quedan en NVS y tienen prioridad
// sobre las de este archivo (ver loadWifiCredentials() en esp32_qube.ino).
//
// Si no querés credenciales por defecto, dejá las cadenas vacías: el firmware
// arranca igual y queda accesible por el SoftAP (SSID "QUBE-ESP32").

#ifndef CREDENTIALS_H
#define CREDENTIALS_H

#define DEFAULT_STA_SSID "TU_RED_WIFI"      // máx. 32 caracteres
#define DEFAULT_STA_PASS "TU_CLAVE_WIFI"    // mín. 8 caracteres (o "" para ninguna)

#endif
